# Copy to .env and fill in. Without keys the app runs in MOCK mode
# (browser speech synthesis instead of ElevenLabs TTS, no Scribe STT,
# heuristic ranker instead of the LLM).
ELEVENLABS_API_KEY=
# Optional extra keys, comma separated. When one runs out of credits the next takes over.
ELEVENLABS_API_KEYS=
ANTHROPIC_API_KEY=

# ElevenLabs models (verify the ids against your plan on day 0)
STT_MODEL=scribe_v1
TTS_MODEL=eleven_flash_v2_5
# Any voice id from your ElevenLabs voice library; replaced once you design/clone a voice
DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Free tier allows 2 concurrent requests
ELEVENLABS_CONCURRENCY=2

# Free-tier budget (per key, per month). The app stops using a key at (1 - reserve) of its limit.
ELEVENLABS_CREDITS_PER_KEY=10000
ELEVENLABS_CREDIT_RESERVE=0.05
# Local cost estimates; replaced by the account's own counter whenever it can be read.
# Check both against the current ElevenLabs pricing page.
TTS_CREDITS_PER_CHAR=0.5
STT_CREDITS_PER_MINUTE=400
# Below this share of credits left, patient speech skips Scribe whenever a recorded phrase matches.
SAVER_MODE_BELOW=0.25
# Credit savers for Scribe
STT_REUSE_MAX_DIST=3.0
SKIP_STT_CONFIDENCE=0.85
MAX_STT_SECONDS=15

# Intent ranker
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_S=4

DB_PATH=data/app.db

# --- Database. Empty = local SQLite files in data/. For Neon use the DIRECT connection string
# (the host without "-pooler"), e.g. postgresql://user:password@ep-xxx.region.aws.neon.tech/clio?sslmode=require
DATABASE_URL=

# --- Phrase matching (backend/matcher.py): auto | ssl | robust | mfcc
MATCHER=auto
SSL_MODEL_PATH=models/wavlm-base-plus-l6.int8.onnx
